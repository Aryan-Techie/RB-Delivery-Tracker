{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RB Tracker",
  "version": "1.1.0",
  "identifier": "com.rbtracker.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "RB Tracker", "width": 1320, "height": 860, "minWidth": 960, "minHeight": 600, "maximized": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "tracking/": "tracking/" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
